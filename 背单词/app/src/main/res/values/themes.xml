<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VocabFlashcard" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!-- 全屏弹窗主题：无标题栏、全屏 -->
    <style name="Theme.VocabFlashcard.Popup" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/popup_bg</item>
    </style>
</resources>
